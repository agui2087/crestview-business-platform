# Supabase is intentionally not connected yet.
# Create a Supabase project before supplying real values in .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional managed malware scanning. When set, document uploads fail closed
# unless Cloudmersive's advanced scanner returns a clean result.
CLOUDMERSIVE_VIRUS_API_KEY=

# Optional HTTPS incident receiver for server, upload, auth, webhook, and
# payment failures. The token is sent only as a server-side Bearer credential.
CRESTVIEW_ALERT_WEBHOOK_URL=
CRESTVIEW_ALERT_WEBHOOK_TOKEN=

# OpenAI must only be used from server-side modules.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Public URL used in account confirmation emails.
NEXT_PUBLIC_SITE_URL=https://www.crestviewplatform.com

# Stripe sandbox configuration. Add real test values only in .env.local and
# Vercel Environment Variables. Never commit restricted keys or webhook secrets.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=

# Server-side Stripe Price allowlist.
STRIPE_PRICE_CRESTVIEW_PRO=
STRIPE_PRICE_SINGLE_LISTING=
STRIPE_PRICE_BROKER_PLAN=
STRIPE_PRICE_ENHANCED_VISIBILITY=
STRIPE_PRICE_HIGHEST_VISIBILITY=
STRIPE_PRICE_WORKFORCE=

# Optional release label used by operational health reporting. Vercel supplies
# VERCEL_GIT_COMMIT_SHA automatically in hosted environments.
CRESTVIEW_RELEASE=

# Enable only after the private-pilot migration, consent language, and participant
# support process are ready. When unset, pilot telemetry and feedback UI stay off.
CRESTVIEW_PILOT_ENABLED=false
