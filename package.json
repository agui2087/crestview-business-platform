{
  "name": "business-operating-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "db:generate": "drizzle-kit generate",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test lib/*.test.ts",
    "test:e2e": "playwright test",
    "monitor:production": "node scripts/production-monitor.mjs",
    "test:load": "node scripts/load-test.mjs",
    "verify:scanner": "node scripts/verify-cloudmersive.mjs",
    "test:security": "npm audit --omit=dev --audit-level=high",
    "test:ci": "npm run typecheck && npm run lint && npm run test:security && npm test && npm run build && npm run test:e2e",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "openai": "^6.49.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "ws": "8.21.3"
  },
  "type": "module"
}
